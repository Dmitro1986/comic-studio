<!DOCTYPE html>
<html lang="{{ lang|default('ru') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — visual essay</title>
  <style>
    {{ css_block }}
  </style>
</head>
<body>
  <div class="container">

    {# ═══ ОБЛОЖКА ═══ #}
    <div class="cover">
      <div class="tagline">{{ tagline }}</div>
      <h1>{{ title }}</h1>
      {% if subtitle %}
      <div class="subtitle">{{ subtitle }}</div>
      {% endif %}
      <div class="meta">
        {% for line in meta_lines %}
        <p>{{ line|safe }}</p>
        {% endfor %}
        <p style="margin-top: 20px; color: var(--accent-light);">📱 Тапните на картинку для увеличения</p>
      </div>
      {% if epigraph %}
      <div class="epigraph">
        {{ epigraph|safe }}
      </div>
      {% endif %}
    </div>

    {# ═══ СПРАВКА (GLOSSARY) — collapsible by default ═══ #}
    {% if glossary %}
    <div class="glossary" id="glossary">
      <button class="glossary-toggle" id="glossaryToggle" aria-expanded="false" aria-controls="glossaryContent">
        <span class="glossary-toggle-icon" aria-hidden="true">▸</span>
        <span class="glossary-toggle-text">{{ glossary_title }}</span>
        <span class="glossary-toggle-count" id="glossaryCount" aria-hidden="true"></span>
      </button>
      <div class="glossary-content" id="glossaryContent" hidden>
        <h2>{{ glossary_title }}</h2>
        <dl>
          {% for term, definition in glossary %}
          <dt>{{ term }}</dt>
          <dd>{{ definition }}</dd>
          {% endfor %}
        </dl>
        {% if author %}
        <dl class="author-block">
          <dt class="author-label">{{ author_label }}</dt>
          <dd class="author-name">{{ author }}</dd>
        </dl>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# ═══ НАВИГАЦИЯ ═══ #}
    {% if panels %}
    <nav class="nav">
      {% if glossary %}<a href="#glossary">↑ Справка</a>{% endif %}
      {% for panel in panels %}
      <a href="#act-{{ panel.n }}">{{ roman_numeral(panel.n) }} · {{ panel.page_title }}</a>
      {% endfor %}
    </nav>
    {% endif %}

    {# ═══ РАССКАЗ ПОЛНОСТЬЮ ═══ #}
    {% if narrative_paragraphs %}
    <div class="narrative">
      {% for para in narrative_paragraphs %}
      <p>{{ para|safe }}</p>
      {% endfor %}
    </div>
    {% endif %}

    {# ═══ АКТЫ (PAGES) ═══ #}
    {% for panel in panels %}
    <div class="page" id="act-{{ panel.n }}">
      <div class="page-header">
        <div class="page-number">{{ roman_numeral(panel.n) }}</div>
        <div class="page-title">{{ panel.page_title }}</div>
      </div>
      <div class="page-render" data-comic="{{ loop.index0 }}" data-title="{{ panel.page_title }}">
        <div class="zoom-hint">🔍 тап для увеличения</div>
        <img src="{{ panel.image_url }}" alt="{{ panel.alt_text }}" loading="lazy">
      </div>
    </div>
    {% endfor %}

    {# ═══ ЭПИЛОГ ═══ #}
    {% if epilogue_text %}
    <div class="epilogue">
      <h2>{{ epilogue_title|default('Контекст') }}</h2>
      <div class="epilogue-text">
        {{ epilogue_text|safe }}
        {% if epilogue_author %}
        <span class="author">— {{ epilogue_author }}</span>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# ═══ FOOTER ═══ #}
    <div class="footer">
      <p>{{ sources_title }}</p>
      {% if source_url %}
      <p class="source-link">🔗 <a href="{{ source_url }}" target="_blank" rel="noopener">{{ source_url }}</a></p>
      {% endif %}
      <div class="tech">
        Згенеровано через Visual Studio · {{ provider|default('MiniMax') }} · {{ style_name }}<br>
        Scenario ID: {{ scenario_id }} · {{ panels|length }} панелей
      </div>
    </div>

  </div>

  {# ═══ MODAL / LIGHTBOX ═══ #}
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Увеличенное изображение">
    <button class="modal-close" id="modalClose" aria-label="Закрыть">×</button>
    <button class="modal-nav modal-prev" id="modalPrev" aria-label="Предыдущая">‹</button>
    <div class="modal-content">
      <img id="modalImg" src="" alt="">
    </div>
    <button class="modal-nav modal-next" id="modalNext" aria-label="Следующая">›</button>
    <div class="modal-counter" id="modalCounter"></div>
  </div>

  <script>
    (function() {

      // ── Collapsible glossary ──────────────────────────────────────
      const glossaryToggle = document.getElementById('glossaryToggle');
      const glossaryContent = document.getElementById('glossaryContent');
      const glossaryCount = document.getElementById('glossaryCount');
      if (glossaryToggle && glossaryContent) {
        // Render the term count once at boot — clicked only flips visibility
        if (glossaryCount) {
          const terms = glossaryContent.querySelectorAll('dl:not(.author-block) > dt').length;
          const plural = (n) => {
            const mod10 = n % 10;
            const mod100 = n % 100;
            if (mod10 === 1 && mod100 !== 11) return 'термин';
            if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return 'термина';
            return 'терминов';
          };
          if (terms > 0) {
            glossaryCount.textContent = `${terms} ${plural(terms)}`;
          } else {
            glossaryCount.textContent = '';
          }
        }

        glossaryToggle.addEventListener('click', () => {
          const isOpen = glossaryToggle.getAttribute('aria-expanded') === 'true';
          const nextOpen = !isOpen;
          glossaryToggle.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
          if (nextOpen) {
            glossaryContent.removeAttribute('hidden');
          } else {
            // Allow the transition to play before hiding
            setTimeout(() => {
              if (glossaryToggle.getAttribute('aria-expanded') === 'false') {
                glossaryContent.setAttribute('hidden', '');
              }
            }, 400);
          }
        });
      }

      const comics = Array.from(document.querySelectorAll('.page-render'));
      const modal = document.getElementById('modal');
      const modalImg = document.getElementById('modalImg');
      const modalClose = document.getElementById('modalClose');
      const modalPrev = document.getElementById('modalPrev');
      const modalNext = document.getElementById('modalNext');
      const modalCounter = document.getElementById('modalCounter');

      let currentIndex = 0;

      function openModal(index) {
        currentIndex = index;
        const img = comics[index].querySelector('img');
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        updateCounter();
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      function next() {
        currentIndex = (currentIndex + 1) % comics.length;
        const img = comics[currentIndex].querySelector('img');
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        updateCounter();
      }

      function prev() {
        currentIndex = (currentIndex - 1 + comics.length) % comics.length;
        const img = comics[currentIndex].querySelector('img');
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        updateCounter();
      }

      function updateCounter() {
        const title = comics[currentIndex].dataset.title || '';
        modalCounter.textContent = (currentIndex + 1) + ' / ' + comics.length + ' · ' + title;
      }

      comics.forEach((el, idx) => el.addEventListener('click', () => openModal(idx)));
      modalClose.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      modalNext.addEventListener('click', (e) => { e.stopPropagation(); next(); });
      modalPrev.addEventListener('click', (e) => { e.stopPropagation(); prev(); });
      document.addEventListener('keydown', (e) => {
        if (!modal.classList.contains('active')) return;
        if (e.key === 'Escape') closeModal();
        else if (e.key === 'ArrowRight') next();
        else if (e.key === 'ArrowLeft') prev();
      });
    })();
  </script>
</body>
</html>
